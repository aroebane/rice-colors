# Whitelist. Every path is ignored unless re-included below.

*
!/.gitignore
!/meson.build
!/Makefile
!/meson_options.txt
!/README.md
!/LICENSE
!/NOTICE
!/CREDITS.md
!/VERSION
!/EGM.md
!/.clang-format
!/.clang-tidy
!/.clangd
!/.editorconfig
!/.gitattributes

!/include/
!/include/rice-colors/
!/include/rice-colors/*.h

!/src/
!/src/*.c

!/tests/
!/tests/meson.build
!/tests/*.c
!/tests/*.h
!/tests/*.cpp
!/tests/*.sh
!/tests/golden/
!/tests/golden/*.tsv

!/oracle/
!/oracle/meson.build
!/oracle/*.c
!/oracle/*.cpp
!/oracle/*.h
